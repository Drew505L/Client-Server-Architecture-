                this.add(usernametext);
                this.add(usernamefield);
                this.add(sendemailbutton);
                this.add(backtologinbutton);

                // Calls the method that handles events
                RecoveryGUIEvents();
            }

            public void RecoveryGUIEvents(){

                // Sends an email to the associated username within the database
                // Placeholder: If possible, check to see if the username is valid within the database and give the user an error if the username does not exist
                sendemailbutton.addActionListener(arg0 ->{
                    String username = usernamefield.getText();
                    try {
                        if(client.recoverPassword(username)){
                            JOptionPane.showMessageDialog(this, "An Email has been sent to the associated username.", "Success", JOptionPane.INFORMATION_MESSAGE);
                            System.out.println("An email has been sent to the user to recovery their password");
                            // After an email has been sent, close recovery page and goes back to the login page
                            RecoveryPage.this.setVisible(false);
                            new LoginPage();
                        }else{
                            JOptionPane.showMessageDialog(this, "Username Doesn't Exist", "Error", JOptionPane.ERROR_MESSAGE);
                        }
                    } catch (SQLException e) {
                        throw new RuntimeException(e);
                    }

                });

                // Takes the user back to the login page
                backtologinbutton.addActionListener(arg0 -> {
                    RecoveryPage.this.setVisible(false);
                    new LoginPage();
                });
            }
        }
    }

